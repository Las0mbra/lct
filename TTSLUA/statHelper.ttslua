-- FTC-GUID: b7ac7a,7c7c20

version = "1.0-11th Edition"
useCustomTrayDice = false
rangeMeleeToggle = 0
modelWeaponToggle = true
lightTheme = true
currentSelection = {}
spawnedDiceCount = 0
spawnPosition = nil
activeCustomTrayDiceConfig = false

--========================
-- 📦 INITIALIZATION
--========================
function onSave()
  return JSON.encode({
    spawnPosition = spawnPosition
  })
end

function onLoad(data)
  self.tooltip = false
  self.setColorTint({0, 0, 0, 0})
  self.addContextMenuItem("Version", onVersionClicked)
  if(getStatsHelperCustomDiceMat() == nil) then
	self.addContextMenuItem("Set Spawn Position", onSetSpawnPositionClicked)
	self.addContextMenuItem("Reset Spawn Position", onResetSpawnPositionClicked)
	spawnPosition = self.positionToWorld({0, 1, 6})
  end
  rangeMeleeToggle = 0
  lightTheme = true
  applyTheme()
end

function onVersionClicked()
  printToAll("📘 Weapon Analyzer v" .. version .. " by Old Man", {0.8, 0.8, 0.5})
end

--========================
-- 🎨 THEME
--========================
-- Named color roles per theme, keyed by role name so every UI builder reads
-- the same palette instead of hardcoding hex. The dark theme mirrors the
-- colors baked into ftc_base.json's XmlUI defaults (that JSON governs the
-- very first render, before any Lua UI.setAttribute call ever runs) --
-- keep both in sync if either changes.
THEME = {
  dark = {
    bgToggle    = "#111417",
    bgHeader    = "#24292D",
    bgFilter0   = "#1C2024",
    bgFilter1   = "#252A30",
    bgFilter2   = "#1E2126",
    bgTable     = "#252525",
    bgRowRanged = "#252A30CC",
    bgRowMelee  = "#1E2126CC",
    bgAttackBtn = "#404040BF",
    textAccent  = "#e6d36f",
    textBody    = "#d0d0d0",
    textBright  = "#fdfcfa",
    textDim     = "#55606A",
    bannerBg    = "#15191C",
    bannerText  = "#C2A661"
  },
  light = {
    bgToggle    = "#E4DEC8",
    bgHeader    = "#D8CFAE",
    bgFilter0   = "#EAE3CC",
    bgFilter1   = "#DED5B8",
    bgFilter2   = "#D2C8A6",
    bgTable     = "#F1ECDD",
    bgRowRanged = "#EAE3CCE6",
    bgRowMelee  = "#DED5B8E6",
    bgAttackBtn = "#C9BE9ABF",
    textAccent  = "#7A5B14",
    textBody    = "#2B2A25",
    textBright  = "#141310",
    textDim     = "#8C8368",
    bannerBg    = "#C7BB98",
    bannerText  = "#3D2E10"
  }
}

function currentTheme()
  return lightTheme and THEME.light or THEME.dark
end

function toggleLightTheme(player, value, id)
  lightTheme = not lightTheme
  applyTheme()
end

function updateLightThemeUI()
  local t = currentTheme()
  self.UI.setAttribute("LightThemeToggle", "color", t.bgToggle)
  self.UI.setAttribute("LightThemeToggle", "text", lightTheme and "Dark Theme" or "Light Theme")
  self.UI.setAttribute("LightThemeToggle", "textcolor", t.textAccent)
end

-- Restyles every element the XML bakes statically (buttons + header labels
-- that don't get rebuilt by drawWeaponData) and then forces the weapon table
-- to redraw so its rows -- built fresh from currentTheme() each time -- pick
-- up the new palette too.
function applyTheme()
  local t = currentTheme()

  updateLightThemeUI()
  updateCustomDiceUI()
  updateRangeMeleeUI()
  updateWpnModelButtonUI()

  self.UI.setAttribute("Clean", "color", t.bgToggle)
  self.UI.setAttribute("Clean", "textcolor", t.textAccent)
  self.UI.setAttribute("ShowStatsBtn", "color", t.bgToggle)
  self.UI.setAttribute("ShowStatsBtn", "textcolor", t.textAccent)

  -- Each header label sits in its own Panel rather than relying on the
  -- TableLayout's rowBackgroundColor: that attribute is only honored when
  -- TTS first builds the row, so setting it here after load doesn't
  -- reliably repaint an already-rendered row. Panel.color, like every other
  -- per-element color used elsewhere in this file, does update live.
  self.UI.setAttribute("HeaderStatsPanel", "color", t.bgHeader)
  self.UI.setAttribute("HeaderAbilitiesPanel", "color", t.bgHeader)
  self.UI.setAttribute("HeaderAttacksPanel", "color", t.bgHeader)
  self.UI.setAttribute("HeaderRangePanel", "color", t.bgHeader)
  self.UI.setAttribute("HeaderStats", "color", t.textAccent)
  self.UI.setAttribute("HeaderAbilities", "color", t.textAccent)
  self.UI.setAttribute("HeaderAttacks", "color", t.textAccent)
  self.UI.setAttribute("HeaderRange", "color", t.textAccent)

  drawWeaponData(currentSelection)
end

--========================
-- 🎯 SELECTION HANDLING
--========================
function setCurrentSelection(player)
  local selected = player.getSelectedObjects()
  if #selected == 0 then
    printMessage("⚠️  Select some models first!")
    return false
  end

  -- Filter out models without descriptions
  local validSelection = {}
  for _, obj in ipairs(selected) do
    local desc = obj.getDescription()
    if desc and desc ~= "" then
      table.insert(validSelection, obj)
    end
  end

  if #validSelection == 0 then
    printMessage("⚠️  No valid models with weapon data found!")
    return false
  end

  currentSelection = validSelection
  return true
end

--========================
-- ⚙️ BUTTON HANDLERS
--========================

--MAIN FUNCTION--
function onCountClicked(player)
  currentSelection = {}
  if setCurrentSelection(player) then
	spawnedDiceCount = 0
	drawWeaponData(currentSelection)
	updateCustomDiceUI()
	updateRangeMeleeUI()
	updateWpnModelButtonUI()
  end
end

function onCleanClicked(player)
	rangeMeleeToggle = 0
	spawnedDiceCount = 0
	modelWeaponToggle = true
	drawWeaponData({})
	updateRangeMeleeUI()
	updateCustomDiceUI()
	updateWpnModelButtonUI()
	cleanCurrentVectorLines()
	currentSelection = {}
end

function toggleCustomTrayDice(player, value, id)
  changeCustomDiceState()
  updateCustomDiceUI()
end

function changeCustomDiceState()
	 useCustomTrayDice = not useCustomTrayDice
end

function updateCustomDiceUI()
	local t = currentTheme()
	self.UI.setAttribute("CustomTrayDiceToggle", "color", t.bgToggle)
	self.UI.setAttribute("CustomTrayDiceToggle", "text", useCustomTrayDice and "☑ Custom Dice" or "☐ Custom Dice")
	self.UI.setAttribute("CustomTrayDiceToggle", "textcolor", t.textAccent)
end

function toggleSHRangeMelee(player,value,id)
	changeRangeMeleeState()
	drawWeaponData(currentSelection)
	updateRangeMeleeUI()
	updateWpnModelButtonUI()
	updateCustomDiceUI()
end

function changeRangeMeleeState()
	rangeMeleeToggle = (rangeMeleeToggle + 1) % 3
end

function updateRangeMeleeUI()
    local t = currentTheme()
    local btnText, btnColor
    if rangeMeleeToggle == 0 then
        btnText  = "☷ Filter(All)▼"
        btnColor = t.bgFilter0
    elseif rangeMeleeToggle == 1 then
        btnText  = "☷ Range ▼"
        btnColor = t.bgFilter1
    else
        btnText  = "☷ Melee ▼"
        btnColor = t.bgFilter2
    end

    self.UI.setAttributes("SHRangeToggle", {
        text      = btnText,
        color     = btnColor,
        textcolor = t.textAccent
    })
end

function onGroupModelWpn(player,value,id)
	changeWpnModelState()
	drawWeaponData(currentSelection)
	updateWpnModelButtonUI()
	updateCustomDiceUI()
	updateRangeMeleeUI()
end

function changeWpnModelState()
	modelWeaponToggle = not modelWeaponToggle
end

function updateWpnModelButtonUI()

local t = currentTheme()
self.UI.setAttribute("groupModelWpn", "color", t.bgHeader)
self.UI.setAttribute("groupModelWpn", "text", modelWeaponToggle and "☷ Name (Group by: Model) ▼" or "☷ Name (Group by: Weapon) ▼")
self.UI.setAttribute("groupModelWpn", "textcolor", t.textAccent)
end


--========================
-- 📋 DATA COLLECTION
--========================
function drawWeaponData(figures)
  local data = createFiguresData(figures)
  drawWeaponsDataUI(data)
end

function drawWeaponsDataUI(figuresData)
  local ui = self.UI.getXmlTable()
  if modelWeaponToggle then
	ui[2].children[3].children = createModelGroupedSections(figuresData)
  else
	ui[2].children[3].children = createWeaponGroupedSections(figuresData)
  end
  self.UI.setXmlTable(ui)
end

--========================
-- 🧩 GROUPED TABLE CREATION
--========================


--BY WEAPON


function createWeaponsMap(figuresData)
	local result = {}
	if(rangeMeleeToggle ~= 2) then
		for i,v in ipairs(figuresData) do
			convertWeaponDataToMap(v.ranged, result)
		end
	end
	if(rangeMeleeToggle ~= 1) then
		for i,v in ipairs(figuresData) do
			convertWeaponDataToMap(v.melee, result)
		end
	end
	return result
end

function convertWeaponDataToMap(weaponsData, resultData)
  for i,v in ipairs(weaponsData) do
    local key = getWeaponKey(v)
    if resultData[key] == nil then
      resultData[key] = {
        count = 0,
        attack = 0,
        data = v
      }
    end
    resultData[key].count = resultData[key].count + 1
    resultData[key].attack = resultData[key].attack + v.attack
  end
end

function getWeaponKey(weaponData)
  local n = string.lower(weaponData.name)
  local att = weaponData.attack
  local acc = weaponData.accuracy
  local str = weaponData.strength
  local ap = weaponData.ap
  local d = weaponData.damage
  return n..att..acc..str..ap..d
end


function createWeaponGroupedSections(figuresData)

    local rows = {}

	if #figuresData > 0 then
		table.insert(
			rows,
			createModelHeaderRow("Models",#figuresData)--,stats)
		)
	end

	local weaponMap = createWeaponsMap(figuresData)

	for _, w in pairs(weaponMap) do
		table.insert(rows, createWeaponRow(w,true))
	end

    -- 3. Wrap everything cleanly in a single TableLayout container
    return {
        {
            tag = "TableLayout",
            attributes = {
                preferredWidth = 2600,
                columnWidths = "800 600 470 180", -- Matches your design
                rowBackgroundColor = currentTheme().bgTable,
                childForceExpandHeight = "false"
            },
            children = rows
        }
    }

end


-- / BY WEAPON


-- BY MODEL

function createModelGroupedSections(figuresData)

    local rows = {}
    local groupedModels = groupFiguresByName(figuresData)

    for modelName, modelFigures in pairs(groupedModels) do


		--local firstFig = modelFigures[1] or {}
        --local stats = {
        --    m  = firstFig.m  or "?",
        --    t  = firstFig.t  or "?",
        --    sv = firstFig.sv or "?",
        --    w  = firstFig.w  or "?",
        --    ld = firstFig.ld or "?"
        --}

        -- 1. Insert the header formatted as a Table Row
        table.insert(
            rows,
            createModelHeaderRow(modelName, #modelFigures)--,stats)
        )

        -- 2. Insert the weapon rows directly following that header
        local weaponMap = collectWeapons(modelFigures)
        for _, w in pairs(weaponMap) do
            table.insert(rows, createWeaponRow(w,false))
        end

    end

    -- 3. Wrap everything cleanly in a single TableLayout container
    return {
        {
            tag = "TableLayout",
            attributes = {
                preferredWidth = 2600,
                columnWidths = "800 600 470 180", -- Matches your design
                rowBackgroundColor = currentTheme().bgTable,
                childForceExpandHeight = "false"
            },
            children = rows
        }
    }

end

function createModelHeaderRow(modelName, count)--,stats)

    local t = currentTheme()
    local countText = ""
    if count ~= nil and count > 1 then
        countText = "  x" .. count
    end

    return {
        tag = "Row",
        attributes = {
            preferredHeight = 80,
            --backgroundColor = "#15191C"
        },
        children = {
            {
                tag = "Cell",
                attributes = {
                    columnSpan = 5, -- Span across all weapon stat columns
                    --dontUseAsHeight = "true"
                },
                children = {
                        tag = "Panel",
						attributes = { color = t.bannerBg,
									   preferredWidth = pwidth or preferredWidth,
									   raycastTarget = false
									 },
						children = {
						tag = "Text",
							attributes = {
								text = "<size=42>★ " .. modelName  .. "<b>" .. countText .. "</b>" .. " ★ " .. "</size>",--<size=35>(T:" .. stats.t .. " Sv:" .. stats.sv .. ")</size>",
								--fontSize = 42,
								color = t.bannerText,
								alignment = "Middle",
								offsetXY = "20 0" -- Margins so text isn't stuck to edge
							}
                    }
                }
            }
        }
    }

end


function collectWeapons(modelFigures)

    -- 🧮 Collect and combine weapons
    local weaponMap = {}
    for _, fig in ipairs(modelFigures) do
		if(rangeMeleeToggle ~= 2) then
			for _, w in ipairs(fig.ranged) do
				local acc = fig.bs or "?"
				local key = "r_"..w.name .. "_" .. acc
				weaponMap[key] = weaponMap[key] or { data = w, count = 0, accuracy = acc, is_melee = false }
				weaponMap[key].count = weaponMap[key].count + 1
			end
		end
		if(rangeMeleeToggle ~= 1) then
			for _, w in ipairs(fig.melee) do
				local acc = fig.ws or "?"
				local key = "m_" .. w.name .. "_" .. acc
				weaponMap[key] = weaponMap[key] or { data = w, count = 0, accuracy = acc, is_melee = true }
				weaponMap[key].count = weaponMap[key].count + 1
			end
		end
	end

    return weaponMap

end


function createWeaponRow(w,wpnMode)

    -- ⚔️ Weapon rows

      local attackStr = ""
        if w.data.bonusAttack and w.data.bonusAttack ~= "" then
          attackStr = w.data.bonusAttack
        elseif w.data.attack and tonumber(w.data.attack) then
          attackStr = tostring(w.data.attack)
        else
          attackStr = "0"
        end

        local decomposed = DecomposeAttackStr(attackStr)
        decomposed.numD6 = decomposed.numD6 * w.count * w.data.wpnMultiplier
        decomposed.numD3 = decomposed.numD3 * w.count * w.data.wpnMultiplier
        decomposed.rawNum = decomposed.rawNum * w.count * w.data.wpnMultiplier
        attackStr = ComposeAttack(decomposed)

	  local displayName
	  if wpnMode and w.count > 1 then
		displayName =  w.data.name .. " x" .. w.count
	  else
		displayName =  w.data.name
      end
	  local t = currentTheme()
	  local abilitiesColor
      if string.match(w.data.wpnabilities,"^-$") then
			abilitiesColor = t.textDim
	  else
			abilitiesColor = t.textBody
	  end
	  local displayCell
	  local statCell
	  local abilitiesCell
	  local attackButtonCell

      local rangeCell
      if w.data.range ~= nil then
        local rangeText = getRangeText(w.data.range)
        rangeCell = createButtonCell(rangeText, "rangeButton_" .. w.data.name, "onRangeClicked", t.bgRowRanged, t.textBody)
		displayCell = createColoredCell(displayName, t.bgRowRanged,t.textBody) --"#04392740"
		statCell = createColoredCell(w.data.stats, t.bgRowRanged,t.textBright) --"#04392740","#d0d0d0"
		abilitiesCell = createColoredCell(w.data.wpnabilities,t.bgRowRanged,abilitiesColor) --,"#04392740","#d0d0d0"
		attackButtonCell = createButtonCell(attackStr, "N:" .. w.data.name .. "A:" .. attackStr .. "AP:" .. w.data.ap .. "D:" .. w.data.damage .. "Name:" .. w.data.name, "onAttackClicked",t.bgAttackBtn,t.textBright) --"#043927BF"
      else
        rangeCell = createColoredCell("-",t.bgRowMelee,t.textDim) --"#420D0940","#d0d0d0"
		displayCell = createColoredCell(displayName, t.bgRowMelee,t.textBody) --"#420D0940"
		statCell = createColoredCell(w.data.stats, t.bgRowMelee,t.textBright) --"#420D0940","#d0d0d0"
		abilitiesCell = createColoredCell(w.data.wpnabilities,t.bgRowMelee,abilitiesColor) --"#cccccc"), "#420D0940","#d0d0d0"
		attackButtonCell = createButtonCell(attackStr, "N:" .. w.data.name .. "A:" .. attackStr .. "AP:" .. w.data.ap .. "D:" .. w.data.damage .. "Name:" .. w.data.name, "onAttackClicked",t.bgAttackBtn,t.textBright) --"#420D09BF"
      end


    return {

        tag="Row",

        attributes={

            preferredHeight=100

        },

        children={

            displayCell,
            statCell,
            abilitiesCell,
            attackButtonCell,
            rangeCell

        }

    }
end


-- / BY MODEL

--========================
-- 🎯 WEAPON RANGE CIRCLE
--========================
-- Draws a ring on the table showing how far a weapon can threaten, measured
-- base-edge to base-edge like 40k actually measures range. Only ranged
-- weapons carry a printed range, so this is never wired up for melee rows.
function onRangeClicked(player, value, id)
  local weaponName = string.sub(id, #"rangeButton_" + 1)
  if #currentSelection == 0 then
    printMessage("⚠️  Select some models first!")
    return
  end
  drawRangeForWeapon(weaponName, currentSelection)
end

-- A row can represent one weapon shared by several models in the selection,
-- so re-derive per-figure which of them actually carry it rather than trust
-- the merged row data -- a mixed unit may have some models without this gun.
function drawRangeForWeapon(name, figures)
  local figuresData = createFiguresData(figures)
  for i, v in ipairs(figuresData) do
    local weapon = getFigureWeaponByName(v, name)
    if weapon ~= nil then
      drawFigureRange(weapon.range, figures[i])
    end
  end
end

function getFigureWeaponByName(figureData, weaponName)
  for i, v in ipairs(figureData.ranged) do
    if v.name == weaponName then
      return v
    end
  end
end

-- VectorLines are drawn in the model's own local space and get re-scaled by
-- TTS to match the object's current scale -- so every raw number here is
-- first divided by that scale, making the final on-table result a true,
-- scale-independent inch measurement no matter how big or small this
-- particular miniature has been scaled.
function drawFigureRange(range, figure)
  range = range / figure.getScale()[1]
  local width = (figure.getBounds().size[1] / 2) / figure.getScale()[1]
  figure.setVectorLines({getCircleVectorPoints(range + width, 30, 0.5, 0.1 / figure.getScale()[1])})
end

function getCircleVectorPoints(radius, steps, y, thickness)
  local points = {}
  local angle = 360 / steps

  for i = 0, steps do
    table.insert(points, {
      math.cos(math.rad(angle * i)) * radius,
      y,
      math.sin(math.rad(angle * i)) * radius
    })
  end

  return {
    points = points,
    thickness = thickness
  }
end

function cleanCurrentVectorLines()
  for i, v in ipairs(currentSelection) do
    v.setVectorLines({})
  end
end

--=============================
-- 🔎 DATA PARSING HELPERS
--=============================
function createFiguresData(figures)
  local result = {}
  for _, v in ipairs(figures) do
    table.insert(result, parseFigureData(v))
  end
  return result
end

function parseFigureData(figure)
  local desc = figure.getDescription()
  local lines = splitStr(removeEmptyLines(desc), "\n")
  local result = { ranged = {}, melee = {} }
  result.figureName = figure.getName()

  for i, line in ipairs(lines) do
    local blockName = getBlockName(line)
    if blockName and blockName ~= "abilities" then
      result[blockName] = parseWeaponBlock(lines, i)
    end
  end

  -- Stats line parsing - REMOVE COLOR TAGS FIRST
  local statsHeaders = {"m","t","sv","w","ld","oc"}
  local statsLine = removeColorTags(lines[2] or "")  -- Clean the line first
  local stats = splitStr(statsLine, " ")
  for i, h in ipairs(statsHeaders) do
    result[h] = stats[i]
  end

  return result
end

function parseWeaponBlock(arr, fromIndex)
  local result = {}
  local i = fromIndex
  while i < #arr do
    local name        = parseWeaponName(arr[i + 1])
    local statsRaw    = removeColorTags(arr[i + 2])

	local tempMainWpnStats = getWeaponMainStats(statsRaw)

    table.insert(result, {
      name          = name,
      stats         = tempMainWpnStats[1],
      range         = parseRange(statsRaw),
      attack        = parseWeaponAttack(statsRaw),
      bonusAttack   = parseWeaponBonusAttack(statsRaw),
	  wpnabilities = tempMainWpnStats[2],
	  wpnMultiplier = getWpnMultipliers(name),
	  accuracy      = parseWeaponAccuracy(statsRaw) or "",
      strength      = getWeaponStatValue(statsRaw, "S") or "",
      ap            = getWeaponStatValue(statsRaw, "AP") or "",
      damage        = getWeaponStatValue(statsRaw, "D") or "",
    })
    if getBlockName(arr[i + 3]) ~= nil then
      return result
    end
    i = i + 2
  end
  return result
end

function getBlockName(str)
  if not str then return nil end
  if str:match("[rR]anged [wW]eapons") then return "ranged" end
  if str:match("[mM]elee [wW]eapons") then return "melee" end
  if str:match("[aA]bilities") then return "abilities" end
  return nil
end

--========================
-- ⚔️ WEAPON STATS HELPERS
--========================
function parseWeaponName(data)
  local trimmedSpaces = data:gsub("%s+$", "") --string.match(data, "^(.-)%s*$")
  return string.sub(trimmedSpaces, 9, -4)
end

function removeColorTags(str)
  return str:gsub("%[%x+%]", ""):gsub("%[%-%]", "")
end

function parseWeaponAttack(stats)
  local stat = getWeaponStatValue(stats, "A")
  return tonumber(stat) or 0
end

function parseWeaponBonusAttack(stats)
  local stat = getWeaponStatValue(stats, "A")
  if tonumber(stat) == nil then
    return stat
  end
  return nil
end

function parseWeaponAccuracy(stats)
  return  getWeaponStatValue(stats, "BS") or getWeaponStatValue(stats, "WS")
end

function getWeaponStatValue(stats, statName)
  local statPairs = splitStr(stats, " ")
  for i,v in ipairs(statPairs) do
    local stat = splitStr(v, ":")
    if stat[1] == statName then
      return stat[2]
    end
  end
end

function getWeaponMainStats(stats)
	local result = {}
	result[1] = string.match(stats, "A[^%[]*")
	result[2] = string.match(stats, "%[.*")
	if result[2] then
		result[1] = "" .. string.match(result[1], "(.-)%s*$") .. ""
	else
		result[2] = "-"
	end

	return result
end

function getWpnMultipliers(name)
	return string.match(name, "^(%d+)[xX]") or 1
end


function parseRange(stats)
  local inches = string.find(stats, "″") or string.find(stats, '"')
  if inches != nil then
    return tonumber(string.sub(stats, 1, inches - 1))
  end
end

--========================
-- 📚 GROUPING + DISPLAY
--========================

function groupFiguresByName(data)
  local grouped = {}
  for _, fig in ipairs(data) do
    local name = extractModelName(fig.figureName or "Unknown Model")
    grouped[name] = grouped[name] or {}
    table.insert(grouped[name], fig)
  end
  return grouped
end

function extractModelName(full)
  local name = full:gsub("%[.-%]", ""):gsub("^%s*[%d/]+%s*", "")
  return TrimString(name)
end

function getRangeText(range)
  return range and (tostring(range) .. "″") or "-"
end

--========================
-- 🧱 UI BUILD HELPERS
--========================

function createButtonCell(text, id, click, color, textColor)
	return {
	tag = "Cell",
		children = {
		  {
			tag = "Button",
			attributes = {
			  text = text,
			  id = id,
			  fontSize = 50,
			  onClick = click,
			  color = color or "#363636",
			  textColor = textColor or "#f0f0f0"
			}
		  }
		}
	}
end

function createTextCell(text, color)
  return {
    tag = "Cell",

    children = {
      {
        tag = "Text",
        attributes = {
          text = text,
          color = color or "#f5f5f5",
        }
      }
    }
  }
end

function createColoredCell(text, bgColor, fcolor)
  return {
   tag = "Cell",
    children = {
      {
        tag = "Panel",
        attributes = { color = bgColor or "#252525" }, -- Colors the background
        children = {
          {
            tag = "Text",
            attributes = {
              text = text,
              color = fcolor or "#f5f5f5", -- fcolor applies to text color d0d0d0
			  offsetXY = "10 0", -- Margins so text isn't stuck to edge

            }
          }
        }
      }
    }
  }
end

--========================
-- 🧮 ATTACK PARSING
--========================
function DecomposeAttackStr(attack)
  local numD6, numD3, rawNum = 0, 0, 0
  for _, v in ipairs(splitStr(attack, "+")) do
    v = TrimString(v)
    local nd6 = v:match("^([0-9]*)[dD]6$")
    if nd6 == "" then nd6 = 1 end
    if nd6 then numD6 = numD6 + tonumber(nd6) end
    local nd3 = v:match("^([0-9]*)[dD]3$")
    if nd3 == "" then nd3 = 1 end
    if nd3 then numD3 = numD3 + tonumber(nd3) end
    if v:match("^[0-9]+$") then rawNum = rawNum + tonumber(v) end
  end
  return { numD6 = numD6, numD3 = numD3, rawNum = rawNum }
end

function ComposeAttack(d)
  local parts = {}
  if d.numD6 > 0 then table.insert(parts, (d.numD6 == 1 and "D6" or (d.numD6 .. "D6"))) end
  if d.numD3 > 0 then table.insert(parts, (d.numD3 == 1 and "D3" or (d.numD3 .. "D3"))) end
  if d.rawNum > 0 then table.insert(parts, tostring(d.rawNum)) end
  return #parts > 0 and table.concat(parts, "+") or "0"
end

--========================
-- 🌈 UTILITIES
--========================
function printMessage(txt, color)
  broadcastToAll(txt, color or {1, 0.8, 0.3})
end

function TrimString(s)
  local a = s:match("^%s*()")
  local b = s:match("()%s*$", a)
  return s:sub(a, b - 1)
end

function removeEmptyLines(str)
  return str:gsub("\n%s*\n", "\n")
end

function splitStr(input, sep)
  local t, pattern = {}, "[^" .. (sep or "%s") .. "]+"
  for str in string.gmatch(input, pattern) do table.insert(t, str) end
  return t
end


--=============
--SPAWN DICE
--=============

function onAttackClicked(player, clickType, id)

	local attacksNum = string.match(id, "A:(.-)AP:") or ""
	local apNum = string.match(id, "AP:(.-)D:") or ""
	local dNum = string.match(id, "D:(.-)Name:") or ""
	local wpnName = string.match(id, "Name:(.+)$")

    if attacksNum ~= "" then
        if (string.match(attacksNum,"[dD]")) then
			attacksNum = getBonusAttackValue(attacksNum)
		end
		spawnDices(attacksNum, apNum, dNum, wpnName, spawnedDiceCount)
		spawnedDiceCount = spawnedDiceCount + attacksNum
    else
        print("Error: Could not extract attack data from ID: " .. tostring(id))
    end
end


function getBonusAttackAppendum(appendum)
  if tonumber(appendum) ~= nil then
    return tonumber(appendum)
  end

  if string.find(appendum, "D") ~= nil then
    local split = splitStr(appendum, "D")
    local count = (#split == 2) and tonumber(split[1]) or 1
    local value = (#split == 2) and tonumber(split[2]) or tonumber(split[1])
    local result = 0

    -- Roll the dice and display each result
    for i = 1, count do
      local roll = math.random(value)
      printMessage("Rolling one D" .. value .. ", the value is: " .. roll)
      result = result + roll
    end
    return result
  end

  return 0
end


function getBonusAttackValue(bonusAttack)
  local appendums = splitStr(bonusAttack, "+")
  local result = 0
  for i,app in ipairs(appendums) do
    result = result + getBonusAttackAppendum(app)
  end
  return result
end


function spawnDices(count, ap,d, wpnName, offset)

  local previousTrayDiceConfig = activeCustomTrayDiceConfig
  activeCustomTrayDiceConfig = readCustomTrayDiceConfig()

  -- Anchor the grid on the dice mat so dice land where the mat can manage them.
  -- Fall back to this object only if the mat can't be resolved.
  local anchor = getStatsHelperCustomDiceMat() or nil
  local anchorRotation = nil
  if(anchor ~= nil) then
		anchorRotation = anchor.getRotation() + Vector(0.0, 180.0, 0.0)
  else
		anchorRotation = self.getRotation() + Vector(0.0, 180.0, 0.0)
  end
  local color = {math.random(), math.random(), math.random()}

  -- Hard-cap total stats dice at 128, matching the mat's own spawn limit, so a
  -- huge attack count can never exceed the grid's footprint.
  local diceLimit = 128
  if offset + count > diceLimit then
    printMessage("Dice limit reached - Clear or Load Models Again")
    count = math.max(0, diceLimit - offset)
  end

  -- Advance grid/row/col to the running offset so each weapon's batch tiles
  -- after the previous one (5 columns x 5 rows per grid block).
  local grid, row, col = 0, 0, 0
  for i = 1, offset do
    col = col + 1
    if col > 4 then col = 0; row = row + 1
      if row > 4 then row = 0; grid = grid + 1 end
    end
  end

  local tooltip  = " [C2A661]AP:[-]".. ap .."[-]  [e85545]D:[-]".. d
  local tPosition
  for i = 1, count do
	if(anchor==nil) then
		tPosition = {
						spawnPosition[1] + (col - 2) * 0.6,
						spawnPosition[2] + 0.5,
						spawnPosition[3] + (row - 2) * 0.6
						}
	else
		tPosition = anchor.positionToWorld({4 - grid * 1.5 - col * 0.25, 0.5, -0.3 + row * 0.25})
	end
      local die = spawnObject({
      type = getDiceType(),
	  position = tPosition,
      rotation = anchorRotation,
      callback_function = function(dice)
        setDieTint(dice, color)
        dice.setName("[E6C75A]" .. wpnName .. "[-]")
		dice.setDescription(tooltip)
      end
    })
    setDieCustomObject(die)

	--Wait.time(function()
    --spawnObject({
    --    type = getDiceType(),
    --    position = tPosition,
    --    rotation = anchorRotation,
    --    callback_function = function(dice)
    --        setDieTint(dice, color)
    --        dice.setName(tooltip)
    --        setDieCustomObject(dice)
    --    end
    --})
	--end, i * 0.05)

    col = col + 1
    if col > 4 then col = 0; row = row + 1
      if row > 4 then row = 0; grid = grid + 1 end
    end

  end

  activeCustomTrayDiceConfig = previousTrayDiceConfig

end

function setDieCustomObject(die)
  local trayConfig = getCustomTrayDiceConfig()
  if trayConfig and trayConfig.customDiceImage then
    die.setCustomObject({ image = trayConfig.customDiceImage, type = 1 })
  end
end

function setDieTint(die, color)
  local trayConfig = getCustomTrayDiceConfig()
  if trayConfig and trayConfig.selectedColor then
    die.setColorTint(trayConfig.selectedColor)
    return
  end
  die.setColorTint(color)
end

function getDiceType()
  local trayConfig = getCustomTrayDiceConfig()
  if trayConfig and trayConfig.diceType then
    return trayConfig.diceType
  end
  return "Die_6"
end

function getCustomTrayDiceConfig()
  if activeCustomTrayDiceConfig ~= false then
    return activeCustomTrayDiceConfig
  end
  return readCustomTrayDiceConfig()
end

function readCustomTrayDiceConfig()
  if not useCustomTrayDice then return nil end
  local mat = getStatsHelperCustomDiceMat()
  if not mat then return nil end
  return copyCustomTrayDiceConfig(mat.call("getStatsHelperDiceConfig"))
end

function copyCustomTrayDiceConfig(config)
  if type(config) ~= "table" then return nil end
  return {
    diceType = config.diceType,
    selectedColor = copyColorValue(config.selectedColor),
    customDiceImage = config.customDiceImage
  }
end

function copyColorValue(value)
  if type(value) ~= "table" then return value end
  return {value[1], value[2], value[3], value[4]}
end

function getStatsHelperCustomDiceMat()
  local guid
  if self.getGUID() == "7c7c20" then
    guid = Global.getVar("redCustomDiceMat_GUID")
  elseif self.getGUID() == "b7ac7a" then
    guid = Global.getVar("blueCustomDiceMat_GUID")
  elseif self.getPosition().z > 0 then
    guid = Global.getVar("redCustomDiceMat_GUID")
  else
    guid = Global.getVar("blueCustomDiceMat_GUID")
  end
  return guid and getObjectFromGUID(guid) or nil
end

function onResetSpawnPositionClicked()
  spawnPosition = self.positionToWorld({0, 1, 6})
  spawnedDiceCount = 0
  printMessage("Spawn position reset complete!")
end

function onSetSpawnPositionClicked()
    local marker = findSpawnPositionMarker()
    if marker == nil then
        createSpawnPositionMarker()
        printMessage("Place the marker on the desired position and click \"Set Spawn Position\" again")
    else
        saveSpawnPosition(marker)
        printMessage("Spawn position successfully configured!")
    end
end


function saveSpawnPosition(marker)
  spawnPosition = {marker.getPosition()[1] - 1, marker.getPosition()[2], marker.getPosition()[3] - 1}
  marker.destruct()
end

function createSpawnPositionMarker()
  spawnObject({
    type = "go_game_piece_white",
    position = getPositionAboveMe(),
    callback_function = function(obj)
      obj.setName("Place me on the spawn position and click \"Set Spawn\" again")
      obj.addTag("SpawnMarker")
    end
  })
end

function findSpawnPositionMarker()
  local objs = getAllObjects()

  for i,v in ipairs(objs) do
    if v.hasTag("SpawnMarker") then
      return v
    end
  end
end

function getPositionAboveMe()
  return self.positionToWorld({0, 1, 6})
end
